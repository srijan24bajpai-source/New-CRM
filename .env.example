# ---- Vercel: set these in Project -> Settings -> Environment Variables ----
# DATABASE_URL is added automatically when you connect a Neon / Vercel Postgres database.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password-1
CRON_SECRET=any-long-random-string
# Optional: TIMEZONE=Asia/Kolkata  IDLE_MINUTES=720  SESSION_DAYS=30

# ---- VPS with docker compose (never commit the real .env) ----
DOMAIN=crm.example.com
DB_PASSWORD=choose-a-strong-database-password
